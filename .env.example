# Environment Configuration Template for CogniTrace Dataset Collection Platform

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME=CogniTrace Dataset Collection Platform

# Security / Authentication
SECRET_KEY=replace_this_with_a_secure_random_32_character_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27018
MONGODB_DB_NAME=cognitrace_db

# Faster-Whisper Configuration
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
